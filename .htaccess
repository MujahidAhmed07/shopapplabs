# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION
<IfModule mod_passenger.c>
    PassengerAppType node
    PassengerStartupFile app.js
    PassengerEnabled on
</IfModule>

# Allow public web access to .next/static directory
<DirectoryMatch "^.*/\.next/static">
    Options +FollowSymLinks
    Require all granted
</DirectoryMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Directly map /_next/static/ requests to .next/static/ for instant Apache CSS/JS serving
    RewriteRule ^_next/static/(.*)$ .next/static/$1 [L]

    # Forward all other requests to Next.js app.js
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ app.js [QSA,L]
</IfModule>
