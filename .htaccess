# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION
<IfModule mod_passenger.c>
    PassengerAppType node
    PassengerStartupFile app.js
    PassengerEnabled on
</IfModule>

# Enable Rewrite Engine for Passenger routing
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Disable ModSecurity rule engine if ModSecurity is active on cPanel causing 400 Bad Request on _next static assets
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>
<IfModule mod_security.c>
    SecRuleEngine Off
</IfModule>

# Set CORS headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>


