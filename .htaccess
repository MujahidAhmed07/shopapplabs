# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION
<IfModule mod_passenger.c>
    PassengerAppType node
    PassengerStartupFile app.js
    PassengerEnabled on
</IfModule>

# Enable Rewrite Engine for Passenger routing
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Cache-Control configuration to prevent chunk mismatches and accelerate static assets
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    
    # Static immutable Next.js assets
    <FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|jpeg|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Disable caching on HTML, dynamic JSON, manifests
    <FilesMatch "\.(html|htm|json|txt|xml)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Disable ModSecurity rule engine if ModSecurity is active on cPanel causing 400 Bad Request on _next static assets
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>
<IfModule mod_security.c>
    SecRuleEngine Off
</IfModule>


