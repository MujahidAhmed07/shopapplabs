# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION
<IfModule mod_passenger.c>
    PassengerAppType node
    PassengerStartupFile app.js
    PassengerEnabled on
</IfModule>

# Enable Rewrite Engine for Passenger routing
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"

    # Static immutable Next.js chunks — long-lived cache (fingerprinted filenames)
    <FilesMatch "\\.(js|css|woff2|woff|ttf|png|jpg|jpeg|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Override: Next.js build manifests must never be cached
    <FilesMatch "(_buildManifest|_ssgManifest|build-manifest|app-build-manifest|routes-manifest)\\.js(on)?$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header unset Expires
    </FilesMatch>

    # HTML, RSC payloads, and text responses — never cache
    <FilesMatch "\\.(html|htm|rsc|txt|xml)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Disable ModSecurity if active on cPanel causing 400 Bad Request on _next static assets
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>
<IfModule mod_security.c>
    SecRuleEngine Off
</IfModule>
